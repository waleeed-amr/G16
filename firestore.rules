rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //   ⚠️  PROJECT SUBMISSION MODE (DEMO)  ⚠️
    // ============================================================
    // These rules are deliberately LOOSE because the project is being
    // submitted in <1 hour and we can't afford any "permission-denied"
    // surprises during the live demo. Any authenticated user can read
    // and write every document in the database.
    //
    // 🚨 SECURITY WARNING — DO NOT KEEP THESE RULES IN PRODUCTION 🚨
    //
    // To restore the original strict rules after submission, replace
    // this whole block with the contents of `firestore.rules.strict`
    // (see ADMIN.md for the migration steps).
    // ============================================================
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
